# Copy this file to .env and fill in your values (never commit .env)
PORT=8080
NODE_ENV=development
# MongoDB Atlas > Connect > Drivers. Replace <user>, <password> and keep the database name (integrador2)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/integrador2?retryWrites=true&w=majority
# Comma-separated frontend origins, or * to allow all
CORS_ORIGIN=*
